# LinkedIn Sales Navigator MCP Server — environment variables
# Copy this file to .env and adjust. This build drives a real logged-in
# browser and captures Sales Navigator's own API responses — there are no
# cookies or API keys to paste. You sign in once with --login.

# Persistent browser profile directory. You log into Sales Navigator here
# once; the session is reused and stays healthy.
USER_DATA_DIR=~/.linkedin-sales-nav/profile

# Browser mode. false = a real visible window (recommended: genuine
# fingerprint keeps the session alive). true = headless (more detectable).
HEADLESS=false

# Optional: path to your own Chrome/Chromium. Leave empty to use the bundled
# Patchright Chromium. Using your everyday Chrome can look more human.
CHROME_PATH=

# Optional proxy for the browser (scheme://host:port). Leave EMPTY when
# running on your own machine — routing through a datacenter proxy is exactly
# what re-introduces the logout problem. Only set this for a residential/home
# exit node if you must run remotely.
PROXY_SERVER=

# Navigation timeout for page loads, seconds (default 60).
NAV_TIMEOUT=60
# How long to wait for a search API response to be captured, seconds (default 25).
CAPTURE_WAIT=25
# How long --login waits for you to finish signing in, seconds (default 300).
LOGIN_TIMEOUT=300

# Per-tool MCP execution timeout, seconds (default 600 — browser work is
# slower than an HTTP call, and the human pacing below deliberately spends
# well over a minute of a 10-page call sitting still).
TOOL_TIMEOUT=600.0

# --- Human pacing -----------------------------------------------------------
# Delays between result pages, so the request cadence looks like reading rather
# than scraping. Raising these is the cheapest way to lower your footprint;
# turning them off makes every page load land on a metronome.

# Master switch (default true). false restores the old fixed-rhythm behaviour.
PACING_ENABLED=true

# Dwell before advancing to the next page — drawn at random from this range,
# seconds (defaults 3-8).
PAGE_DELAY_MIN=3.0
PAGE_DELAY_MAX=8.0

# Every few pages, take a longer break instead of the normal dwell. The
# interval is jittered by ±1 page so the breaks aren't periodic either.
# Set LONG_PAUSE_EVERY=0 to disable long breaks (default 5 pages, 20-45s).
LONG_PAUSE_EVERY=5
LONG_PAUSE_MIN=20.0
LONG_PAUSE_MAX=45.0

# --- Outreach (sending) -----------------------------------------------------
# Sending is the ONLY thing this server does that writes to LinkedIn, so it is
# off by default. A fresh install cannot message anyone.

# Master switch. Even with this true, send_message still defaults to dry_run.
ENABLE_SENDING=false

# Allow messages that consume an InMail credit. Open Profile leads are free to
# message; credits are a finite monthly budget, so spending one is never
# implicit. enrich_leads tells you which leads are free.
ALLOW_CREDIT_SPEND=false

# Rolling-24h cap across ALL campaigns. LinkedIn sees one account, not your
# campaign labels.
SEND_DAILY_CAP=40

# Seconds between sends. Much longer than page pacing on purpose: a burst of
# messages is a far louder signal than a burst of reads.
SEND_DELAY_MIN=45
SEND_DELAY_MAX=120

# Message length caps, enforced before sending.
SUBJECT_MAX_CHARS=120
BODY_MAX_CHARS=1900

# Path to YOUR offer/positioning file, used by the compose prompt. There is no
# default -- without it the prompt refuses to render. Start from
# offer.example.md and keep your real one out of git.
OFFER_FILE=

# Transport mode (default: stdio). Options: stdio, streamable-http
TRANSPORT=

# HTTP server settings (only used for streamable-http transport)
HOST=127.0.0.1
PORT=9000
HTTP_PATH=/mcp

# Logging level (default: WARNING). Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING

# Where the query database and raw captures are stored. This is account state
# and lives beside the browser profile, so it is the same database whatever
# folder you launch from.
STATE_DIR=~/.linkedin-sales-nav

# Where JSON/CSV exports are written, under <OUTPUT_DIR>/<query-hash>/.
# Relative paths are resolved from where the server runs (the project folder,
# under Claude Code), so exports land next to the work they are for.
OUTPUT_DIR=output
